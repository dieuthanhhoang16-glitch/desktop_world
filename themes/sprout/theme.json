{
  "schemaVersion": 1,
  "name": "芽芽 Sprout",
  "author": "Desktop World",
  "version": "0.1.0",
  "description": "桌面世界的园丁 · 程序化 16-bit 像素风占位皮肤（world/creature 生成，可整体替换为 AI 出图）",
  "customization": {
    "petTint": false
  },
  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 16,
    "height": 16
  },
  "layout": {
    "contentBox": {
      "x": 2,
      "y": 2,
      "width": 12,
      "height": 12
    },
    "centerX": 8,
    "baselineY": 14,
    "visibleHeightRatio": 0.72,
    "baselineBottomRatio": 0.06
  },
  "eyeTracking": {
    "enabled": false,
    "states": []
  },
  "states": {
    "idle": [
      "sprout-idle.svg"
    ],
    "roam": [
      "sprout-roam.svg"
    ],
    "yawning": [
      "sprout-yawning.svg"
    ],
    "dozing": [
      "sprout-dozing.svg"
    ],
    "collapsing": [
      "sprout-collapsing.svg"
    ],
    "thinking": [
      "sprout-thinking.svg"
    ],
    "working": [
      "sprout-working.svg"
    ],
    "juggling": [
      "sprout-juggling.svg"
    ],
    "attention": [
      "sprout-attention.svg"
    ],
    "notification": [
      "sprout-notification.svg"
    ],
    "error": [
      "sprout-error.svg"
    ],
    "sweeping": [
      "sprout-sweeping.svg"
    ],
    "carrying": [
      "sprout-carrying.svg"
    ],
    "sleeping": [
      "sprout-sleeping.svg"
    ],
    "waking": [
      "sprout-waking.svg"
    ]
  },
  "sleepSequence": {
    "mode": "full"
  },
  "workingTiers": [
    {
      "minSessions": 3,
      "file": "sprout-building.svg"
    },
    {
      "minSessions": 2,
      "file": "sprout-juggling.svg"
    },
    {
      "minSessions": 1,
      "file": "sprout-working.svg"
    }
  ],
  "jugglingTiers": [
    {
      "minSessions": 2,
      "file": "sprout-conducting.svg"
    },
    {
      "minSessions": 1,
      "file": "sprout-juggling.svg"
    }
  ],
  "idleAnimations": [
    {
      "file": "sprout-idle-happy.svg",
      "duration": 4000
    }
  ],
  "hitBoxes": {
    "default": {
      "x": 2,
      "y": 3,
      "w": 12,
      "h": 12
    },
    "sleeping": {
      "x": 2,
      "y": 6,
      "w": 12,
      "h": 9
    }
  },
  "sleepingHitboxFiles": [
    "sprout-dozing.svg",
    "sprout-collapsing.svg",
    "sprout-yawning.svg",
    "sprout-sleeping.svg",
    "sprout-waking.svg"
  ],
  "miniMode": {
    "supported": true,
    "viewBox": {
      "x": 0,
      "y": 0,
      "width": 8,
      "height": 8
    },
    "states": {
      "mini-idle": [
        "sprout-mini-idle.svg"
      ],
      "mini-alert": [
        "sprout-mini-alert.svg"
      ],
      "mini-happy": [
        "sprout-mini-happy.svg"
      ],
      "mini-enter": [
        "sprout-mini-enter.svg"
      ],
      "mini-peek": [
        "sprout-mini-peek.svg"
      ],
      "mini-working": [
        "sprout-mini-working.svg"
      ],
      "mini-crabwalk": [
        "sprout-mini-crabwalk.svg"
      ],
      "mini-enter-sleep": [
        "sprout-mini-enter-sleep.svg"
      ],
      "mini-sleep": [
        "sprout-mini-sleep.svg"
      ]
    }
  },
  "objectScale": {
    "widthRatio": 1,
    "heightRatio": 1,
    "offsetX": 0,
    "offsetY": 0
  }
}
